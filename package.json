{
  "name": "vscode-acp-client",
  "displayName": "VAC - Agent Client for VS Code",
  "description": "Chat with Claude Code and Codex inside VS Code through the Agent Client Protocol (ACP): multi-session chat, permissions, forms, usage dashboard.",
  "version": "1.0.2",
  "publisher": "zouv",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zouv/vscode-acp-client.git"
  },
  "bugs": {
    "url": "https://github.com/zouv/vscode-acp-client/issues"
  },
  "homepage": "https://github.com/zouv/vscode-acp-client#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "acp",
    "agent",
    "claude",
    "claude code",
    "codex",
    "ai"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vac-client",
          "title": "VAC",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "vac-client": [
        {
          "id": "vac-dashboard",
          "name": "Dashboard",
          "type": "webview"
        },
        {
          "id": "vac-sessions",
          "name": "Agents",
          "type": "tree"
        },
        {
          "id": "vac-chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vac-sessions",
        "contents": "No agents configured.\n[Add Agent](command:vac.addAgent)\nConfigure agents in the `vac.agents` setting."
      },
      {
        "view": "vac-chat",
        "contents": "Start chatting with an AI coding agent.\n[Connect to Agent](command:vac.connectAgent)\nSelect an agent from the list above to begin."
      }
    ],
    "commands": [
      {
        "command": "vac.connectAgent",
        "title": "VAC: Connect to Agent",
        "icon": "$(plug)"
      },
      {
        "command": "vac.newConversation",
        "title": "VAC: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "vac.sendPrompt",
        "title": "VAC: Send Prompt"
      },
      {
        "command": "vac.cancelTurn",
        "title": "VAC: Cancel Current Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vac.disconnectAgent",
        "title": "VAC: Disconnect Agent",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "vac.openChat",
        "title": "VAC: Open Chat Panel"
      },
      {
        "command": "vac.openChatInEditor",
        "title": "VAC: Open Chat in Editor Area",
        "icon": "$(open-preview)"
      },
      {
        "command": "vac.addAgent",
        "title": "VAC: Add Agent Configuration",
        "icon": "$(add)"
      },
      {
        "command": "vac.removeAgent",
        "title": "VAC: Remove Agent"
      },
      {
        "command": "vac.showLog",
        "title": "VAC: Show Log"
      },
      {
        "command": "vac.showTraffic",
        "title": "VAC: Show Protocol Traffic"
      },
      {
        "command": "vac.setMode",
        "title": "VAC: Set Agent Mode"
      },
      {
        "command": "vac.setModel",
        "title": "VAC: Set Agent Model"
      },
      {
        "command": "vac.attachFile",
        "title": "VAC: Attach File to Prompt",
        "icon": "$(attach)"
      },
      {
        "command": "vac.refreshAgents",
        "title": "VAC: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "vac.refreshSessions",
        "title": "VAC: Refresh Sessions"
      },
      {
        "command": "vac.openSession",
        "title": "VAC: Open Session"
      },
      {
        "command": "vac.loadMoreSessions",
        "title": "VAC: Load More Sessions"
      },
      {
        "command": "vac.copySessionId",
        "title": "VAC: Copy Session ID"
      },
      {
        "command": "vac.forgetSession",
        "title": "VAC: Forget Session"
      },
      {
        "command": "vac.restartAgent",
        "title": "VAC: Restart Agent",
        "icon": "$(debug-restart)"
      },
      {
        "command": "vac.refreshDashboard",
        "title": "VAC: Refresh Dashboard",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vac.openSession",
          "when": "false"
        },
        {
          "command": "vac.loadMoreSessions",
          "when": "false"
        },
        {
          "command": "vac.copySessionId",
          "when": "false"
        },
        {
          "command": "vac.forgetSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "vac.refreshDashboard",
          "when": "view == vac-dashboard",
          "group": "navigation@0"
        },
        {
          "command": "vac.openChatInEditor",
          "when": "view == vac-sessions",
          "group": "navigation@0"
        },
        {
          "command": "vac.addAgent",
          "when": "view == vac-sessions",
          "group": "navigation@1"
        },
        {
          "command": "vac.refreshAgents",
          "when": "view == vac-sessions",
          "group": "navigation@2"
        },
        {
          "command": "vac.newConversation",
          "when": "view == vac-chat",
          "group": "navigation@1"
        },
        {
          "command": "vac.attachFile",
          "when": "view == vac-chat",
          "group": "navigation@2"
        },
        {
          "command": "vac.cancelTurn",
          "when": "view == vac-chat && vac.turnInProgress",
          "group": "navigation@3"
        },
        {
          "command": "vac.disconnectAgent",
          "when": "view == vac-chat",
          "group": "navigation@4"
        },
        {
          "command": "vac.showLog",
          "when": "view == vac-chat"
        },
        {
          "command": "vac.showTraffic",
          "when": "view == vac-chat"
        },
        {
          "command": "vac.restartAgent",
          "when": "view == vac-chat"
        },
        {
          "command": "vac.openChatInEditor",
          "when": "view == vac-chat",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "vac.connectAgent",
          "when": "view == vac-sessions && viewItem == agent-disconnected",
          "group": "inline"
        },
        {
          "command": "vac.disconnectAgent",
          "when": "view == vac-sessions && viewItem == agent-connected",
          "group": "inline"
        },
        {
          "command": "vac.removeAgent",
          "when": "view == vac-sessions && viewItem =~ /^agent/"
        },
        {
          "command": "vac.restartAgent",
          "when": "view == vac-sessions && viewItem == agent-connected"
        },
        {
          "command": "vac.refreshSessions",
          "when": "view == vac-sessions && viewItem =~ /^agent/",
          "group": "session@1"
        },
        {
          "command": "vac.copySessionId",
          "when": "view == vac-sessions && viewItem =~ /^session/",
          "group": "session@1"
        },
        {
          "command": "vac.forgetSession",
          "when": "view == vac-sessions && viewItem == session-local",
          "group": "session@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vac.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "vac.openChatInEditor",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "vac.cancelTurn",
        "key": "escape",
        "when": "vac.turnInProgress && (focusedView == 'vac-chat' || activeWebviewPanelId == 'vac-chat-editor')"
      }
    ],
    "configuration": {
      "title": "VAC",
      "properties": {
        "vac.agents": {
          "type": "object",
          "description": "Agent configurations. Each key is the agent name; the value has command, args, env and an optional kind ('claude' | 'codex' | 'generic') that selects the agent profile (inferred from the name/command when omitted).",
          "default": {
            "Claude Code": {
              "kind": "claude",
              "command": "npx",
              "args": [
                "@agentclientprotocol/claude-agent-acp@latest"
              ],
              "env": {}
            },
            "Codex CLI": {
              "kind": "codex",
              "command": "npx",
              "args": [
                "@zed-industries/codex-acp@latest"
              ],
              "env": {}
            }
          }
        },
        "vac.autoApprovePermissions": {
          "type": "string",
          "enum": [
            "ask",
            "allowAll"
          ],
          "default": "ask",
          "description": "Automatically approve agent permission requests. 'ask' always prompts, 'allowAll' approves everything."
        },
        "vac.autoConnectOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Connect the agent automatically 0.5s after the chat panel is opened. The panel's start card shows the same switch; changing either one updates the other."
        },
        "vac.restoreSessionsOnOpen": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "description": "What to do with the sessions that were open when the window last closed: 'ask' shows a card on the empty panel offering to restore them (the card also offers a remember-my-choice switch), 'always' restores them without asking, 'never' ignores them and starts a fresh session."
        },
        "vac.defaultWorkingDirectory": {
          "type": "string",
          "default": "",
          "description": "Default working directory for agent sessions. Leave empty to use the current workspace folder."
        },
        "vac.logTraffic": {
          "type": "boolean",
          "default": true,
          "description": "Log all ACP protocol traffic to the output channel and the log file."
        },
        "vac.customModels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "modelId": {
                "type": "string",
                "description": "The model id injected into the agent via ACP '_meta.extraModels' and sent on selection."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the model dropdown; falls back to modelId when empty."
              },
              "description": {
                "type": "string",
                "description": "Optional hover text."
              }
            },
            "required": [
              "modelId"
            ]
          },
          "default": [],
          "description": "User-defined models injected into the agent's model list via the ACP '_meta.extraModels' field at session creation, so they appear in the model dropdown. Picking one still sends its modelId to the agent; whether it takes effect is up to the agent."
        },
        "vac.dashboard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Scan local agent transcripts to build the usage dashboard. Disable to stop all background scanning."
        },
        "vac.dashboard.claudeProjectsDir": {
          "type": "string",
          "default": "",
          "description": "Override the Claude Code transcript directory (default: ~/.claude/projects)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "precompile": "node scripts/check-webview-client.mjs",
    "compile": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev:host": "node scripts/dev-host.mjs",
    "package": "node scripts/build.mjs --production",
    "vsix": "node scripts/package-vsix.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "vitest run",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
